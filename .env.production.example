APP_NAME=LibSync
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://perpustakaan.sekolah.sch.id
# Optional explicit asset origin; keep it equal to APP_URL on Railway.
ASSET_URL="${APP_URL}"
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=libsync_production
DB_USERNAME=libsync_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_KUAT

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=libsync-session-v2
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@perpustakaan.sekolah.sch.id
MAIL_FROM_NAME="\${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="\${APP_URL}/auth/google/callback"

LIBRARY_FINE_PER_DAY=1000
